# UniHub Grile local configuration example.
# Copy to .env only for local use. Never commit .env or credential files.

APP_ENV=dev

# Google projection provider. The safe standalone default performs no network I/O.
UGRILE_GOOGLE_PROVIDER=fake

# Live Google mutations require BOTH an explicit provider selection and opt-in.
# A credential path is a file-system reference only; never paste JSON credentials here.
UGRILE_GOOGLE_LIVE_MUTATIONS_ENABLED=false
# UGRILE_GOOGLE_CREDENTIALS_FILE=/run/secrets/ugrile-google-service-account.json

# Fake-provider fault injection for local/test resilience checks only.
# UGR_S5_GOOGLE_FAIL=1
