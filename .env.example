# UniHub Grile local/server-test configuration reference.
# Copy to .env only for local use. Never commit .env or credential files.
# Canonical descriptions and prod requirements: docs/operations/environment.md

# Core runtime
APP_NAME=ugrile-backend
APP_ENV=dev
LOG_LEVEL=INFO
TIMEZONE=Europe/Bucharest
UGRILE_HOST=127.0.0.1
UGRILE_PORT=8080

# Database. These credentials are DEVELOPMENT-ONLY and are rejected in APP_ENV=prod.
DATABASE_URL=postgresql+psycopg://grile:grile@127.0.0.1:5432/grile
DATABASE_ECHO=false

# Identity. dev_headers is local/test only and is rejected in APP_ENV=prod.
IDENTITY_PROVIDER=dev_headers

# Connector fixture selector. The fixture ingest route is not mounted in prod.
CONNECTOR_DEFAULT=fixture-v1

# Durable worker
WORKER_ENABLED=true
UGRILE_WORKER_POLL_SECONDS=0.5
UGRILE_WORKER_LEASE_SECONDS=1800

# Generated XLSX artifacts. The root is consumed by export handlers; retention
# settings bound cleanup inside the managed ugrile-s5-exports root.
UGR_S5_EXPORT_DIR=/tmp
UGRILE_EXPORT_RETENTION_HOURS=168
UGRILE_EXPORT_MAX_OPERATIONS=500

# Google projection provider. fake performs no network I/O and is local/test only
# for APP_ENV=prod startup validation.
UGRILE_GOOGLE_PROVIDER=fake
UGRILE_GOOGLE_LIVE_MUTATIONS_ENABLED=false
# Only a filesystem reference is allowed here; never paste credential JSON.
# UGRILE_GOOGLE_CREDENTIALS_FILE=/run/secrets/ugrile-google-service-account.json

# Fake-provider fault injection for local/test resilience checks only.
# UGR_S5_GOOGLE_FAIL=1

# Frontend Vite development proxy only; not a backend runtime variable.
# UGRILE_API_PROXY=http://127.0.0.1:8080

# CI/integration-test helper only; not an application runtime variable.
# UGRILE_PG_URL=postgresql+psycopg://grile:grile@127.0.0.1:5432/grile_test
