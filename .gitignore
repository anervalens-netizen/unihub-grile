# Evidence is opt-in: do not accidentally commit raw logs, employee data, or
# copied Google artifacts. The S1 handoff commit carries sanitised evidence
# explicitly; later stages add their own whitelist rules as needed.
.agent/evidence/**
# Whitelist sanitised evidence that is part of an explicit handoff.
!.agent/evidence/.gitkeep
!.agent/evidence/UGR-001/
!.agent/evidence/UGR-001/S1/
!.agent/evidence/UGR-001/S1/README.md
!.agent/evidence/UGR-001/S1/*.txt

# Credentials and provider files must never enter Git.
config/google/
credentials*.json
token*.json
service-account*.json

